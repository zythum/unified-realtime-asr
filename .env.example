# 模板：复制为 examples/.env.local 并填入真实值。
# examples/.env.local 已被 .gitignore 忽略，不会入库；本文件可安全提交。
# 运行示例：cp examples/.env.example examples/.env.local && npm run dev

# 选择服务商：dashscope | volcengine | openai-realtime
ASR_PROVIDER=dashscope

# DashScope（阿里百炼 / 通义 Fun-ASR）
DASHSCOPE_API_KEY=sk-your-key
DASHSCOPE_MODEL=
DASHSCOPE_WORKSPACE_ID=

# Volcengine（火山引擎 豆包流式语音识别）
VOLC_API_KEY=your-volc-key
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration

# OpenAI Realtime
OPENAI_API_KEY=sk-your-key

# 可选：指定要推流的音频文件（16k 单声道 pcm，或 wav 自动去头）
ASR_PCM_FILE=examples/sample-voice.wav
