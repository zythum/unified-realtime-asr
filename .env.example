# ---------------------------------------------------------------------------
# unified-realtime-asr 环境变量模板
#
#   cp .env.example .env.local     # 然后填入真实值
#
# .env.local 含真实密钥，已被 .gitignore 忽略（`.env.*`）；本文件是模板，可安全提交。
#
# 命名约定：
#   * 方向专有配置一律带 _ASR_ / _TTS_ 中缀：DASHSCOPE_ASR_MODEL、VOLC_ASR_RESOURCE_ID、
#     VOLC_TTS_VOICE、IFLYTEK_TTS_VCN …
#   * 凭证与地域类两个方向共用同一把 / 同一处，所以保持裸名、只写一份
#     （DASHSCOPE_API_KEY、VOLC_API_KEY、OPENAI_API_KEY、IFLYTEK_*、DASHSCOPE_WORKSPACE_ID）
#
# 非密钥项（模型 / resource-id / 音色 / 端口…）已预填为**实测可用**的值，贴上自己的 key 即可跑通；
# 只有密钥类（DASHSCOPE_API_KEY / VOLC_API_KEY / OPENAI_API_KEY / IFLYTEK_*）需要自己填。
# 注意音色与 resource-id 是账号相关的：火山 resource-id 必须与音色配套，讯飞发音人需单独授权。
#
# 这些变量只被 test/ 与 examples/ 读取 —— 库本身从不读环境变量，配置一律由参数传入。
# ---------------------------------------------------------------------------

# ============================ 通用（示例 / 集成测试） ============================

# examples/node 用哪个 provider 推流：dashscope | volcengine | openai | iflytek
ASR_PROVIDER=dashscope

# examples/web 的 HTTP 端口（可选，默认 3000）
PORT=3000

# 示例音频（16k 单声道 pcm；wav 会自动去掉容器头）
ASR_PCM_FILE=fixtures/sample-voice.wav

# ============================== DashScope（阿里百炼） ==============================

DASHSCOPE_API_KEY=sk-your-key
# 识别模型；留空则用适配器默认 fun-asr-flash-8k-realtime
DASHSCOPE_ASR_MODEL=fun-asr-flash-8k-realtime
# 业务空间专属域名用；不填则走 dashscope.aliyuncs.com
DASHSCOPE_WORKSPACE_ID=
# —— 合成（TTS）：模型 + 音色（音色必填，各家不通用）
DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-flash
DASHSCOPE_TTS_VOICE=longanhuan_v3.6

# ============================== Volcengine（火山引擎） ==============================

# 新版控制台 API Key：识别与合成共用同一把
VOLC_API_KEY=your-volc-key
# 识别：X-Api-Resource-Id（决定模型版本与计费）
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 合成：同上的 resource-id。注意 resource-id 与音色必须配套（2.0 音色配 seed-tts-2.0）
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE=zh_female_vv_uranus_bigtts
VOLC_TTS_VOICE_1_0=zh_female_shuangkuaisisi_moon_bigtts

# ==================================== OpenAI ====================================

# 识别（Realtime transcription）与合成（/v1/audio/speech）共用同一把 key
OPENAI_API_KEY=sk-your-key
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# 13 个内置音色（英文优化）：alloy/coral/echo/marin/cedar/…
OPENAI_TTS_VOICE=coral

# ============================== 科大讯飞（讯飞开放平台） ==============================

# 识别与合成共用同一个应用的凭证（注意：两个方向的签名算法不同，适配器各自实现）
IFLYTEK_APP_ID=your-app-id
IFLYTEK_API_KEY=your-api-key
IFLYTEK_API_SECRET=your-api-secret
# 合成发音人。发音人授权与字符量授权是两笔独立授权，未授权会报 11200
IFLYTEK_TTS_VCN=x5_lingxiaoxuan_flow
