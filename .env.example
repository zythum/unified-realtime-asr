# 模板：复制到仓库根 .env.local 并填入真实值。
# .env.local 已被 .gitignore 忽略，不会入库；本文件可安全提交。
# 运行示例：cp .env.example .env.local && npm run example:node-basic

# 选择服务商：dashscope | volcengine | openai | iflytek
ASR_PROVIDER=dashscope

# DashScope（阿里百炼 / 通义 Fun-ASR）
DASHSCOPE_API_KEY=sk-your-key
DASHSCOPE_MODEL=
DASHSCOPE_WORKSPACE_ID=

# Volcengine（火山引擎 豆包流式语音识别）
VOLC_API_KEY=your-volc-key
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration

# OpenAI Realtime
OPENAI_API_KEY=sk-your-key

# 科大讯飞实时语音转写（RTASR 大模型版）
IFLYTEK_APP_ID=your-app-id
IFLYTEK_API_KEY=your-access-key-id
IFLYTEK_API_SECRET=your-access-key-secret

# 可选：指定要推流的音频文件（16k 单声道 pcm，或 wav 自动去头）
ASR_PCM_FILE=fixtures/sample-voice.wav
